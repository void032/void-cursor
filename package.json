{
  "name": "void-cursor",
  "version": "0.1.3",
  "description": "A lightweight, SSR-safe custom cursor for React.",
  "keywords": [
    "react",
    "cursor",
    "custom-cursor",
    "animation",
    "typescript"
  ],
  "license": "MIT",
  "author": "Void Cursor contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/void032/void-cursor.git"
  },
  "homepage": "https://github.com/void032/void-cursor#readme",
  "bugs": {
    "url": "https://github.com/void032/void-cursor/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.lib.json",
    "build:demo": "tsc -b && vite build --mode demo",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run build && npm run typecheck",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "module": "./dist/void-cursor.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/void-cursor.js",
      "default": "./dist/void-cursor.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^4.0.18",
    "jsdom": "^27.0.1"
  }
}
